---
// ─── TREK PAGE LAYOUT ────────────────────────────────────
// Builds the hero, stats bar, photo gallery, sidebar (prices, includes,
// booking form) and all the schema for a trek page. The page itself only
// writes the left-column content (overview, itinerary, FAQ, …).
import BaseLayout from './BaseLayout.astro';
import TrekHero from '../components/trek/TrekHero.astro';
import StatsBar from '../components/trek/StatsBar.astro';
import Gallery from '../components/trek/Gallery.astro';
import PricingCard from '../components/trek/PricingCard.astro';
import IncludesCard from '../components/trek/IncludesCard.astro';
import BookingForm from '../components/trek/BookingForm.astro';
import RelatedTreks from '../components/trek/RelatedTreks.astro';
import '../styles/trek-page.css';
import '../styles/trek-extra.css';
import { SITE, absUrl } from '../data/site.js';
import { getImageSize } from '../lib/image-size.js';
import type { Day } from '../components/trek/Itinerary.astro';
import type { Faq } from '../components/trek/FaqList.astro';
import type { PriceRow } from '../components/trek/PricingCard.astro';

interface Props {
  // SEO
  title: string;
  description: string;
  path: string;              // e.g. "/kokhe-danda-trek"
  keywords?: string;
  image: string;             // social-card photo (og:image), e.g. "/kokhe.jpg"
  imageAlt?: string;         // og:image:alt (defaults to the title)
  twitterImage?: string;     // only if different from image
  ogDescription?: string;    // only if social cards need a different description
  // trek facts
  name: string;              // e.g. "Kokhe Danda Trek" (booking form + breadcrumb)
  tripName?: string;         // schema TouristTrip name, e.g. "Kokhe Danda Trek – 5 Days"
  tripDescription?: string;  // schema TouristTrip description
  updated?: string;          // YYYY-MM-DD: shown under the hero title and as dateModified
  hero: { image?: string; alt: string; eyebrow: string; title: string; subtitle: string }; // hero.image defaults to image
  stats: { value: string; label: string }[];
  gallery: { src: string; alt: string }[];
  pricing: PriceRow[];
  pricingNote?: string;      // line under "Cost Details", default "Per person · All inclusive"
  pricingFootnote?: string;  // small note under the price table
  included: string[];
  notIncluded: string[];
  itinerary: Day[];
  faqs?: Faq[];
  extraSchema?: object[];    // any extra JSON-LD blocks (e.g. a VideoObject)
  bookingName?: string;      // name used in the booking form, if different from name
  related?: string[];        // slugs of treks to show under "More treks you may like"
}

const p = Astro.props;
const url = absUrl(p.path);
const imageUrl = absUrl(p.image);
const imgSize = getImageSize(p.image);
const prices = p.pricing.map((r) => Number(r.price.replace(/[^0-9.]/g, ''))).filter((n) => n > 0);
const strip = (html: string) => html.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
const pageName = p.title.replace(/\s*\|\s*Discover Parbat\s*$/, '');

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': url,
      url,
      name: pageName,
      primaryImageOfPage: { '@type': 'ImageObject', url: imageUrl, ...(imgSize ?? {}) },
      ...(p.updated ? { dateModified: p.updated } : {}),
      thumbnailUrl: imageUrl,
    },
    {
      '@type': 'TouristTrip',
      name: p.tripName ?? p.name,
      description: p.tripDescription ?? p.description,
      image: imageUrl,
      touristType: 'Trekkers',
      provider: {
        '@type': 'TravelAgency',
        '@id': SITE.url + '/#organization',
        name: SITE.name,
        url: SITE.url,
        logo: absUrl(SITE.logo),
        email: SITE.email,
      },
      offers: {
        '@type': 'AggregateOffer',
        lowPrice: String(Math.min(...prices)),
        highPrice: String(Math.max(...prices)),
        priceCurrency: 'USD',
        offerCount: String(prices.length),
        url,
      },
      itinerary: {
        '@type': 'ItemList',
        itemListElement: p.itinerary.map((d, i) => ({ '@type': 'ListItem', position: i + 1, name: d.title })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
        { '@type': 'ListItem', position: 2, name: 'Treks', item: SITE.url + '/treks' },
        { '@type': 'ListItem', position: 3, name: p.name },
      ],
    },
    ...(p.faqs && p.faqs.length
      ? [{
          '@type': 'FAQPage',
          mainEntity: p.faqs.map((f) => ({
            '@type': 'Question',
            name: f.q,
            acceptedAnswer: { '@type': 'Answer', text: strip(f.a) },
          })),
        }]
      : []),
  ],
};
---
<BaseLayout
  title={p.title}
  description={p.description}
  path={p.path}
  keywords={p.keywords}
  image={p.image}
  imageAlt={p.imageAlt}
  twitterImage={p.twitterImage}
  ogDescription={p.ogDescription}
  schema={[schema, ...(p.extraSchema ?? [])]}
  nav="/treks"
>
  <script slot="head" src="/trek-page.js" defer is:inline></script>

  <TrekHero {...p.hero} image={p.hero.image ?? p.image} updated={p.updated} />
  <StatsBar stats={p.stats} />
  <Gallery photos={p.gallery} />

  <div class="page-body">
    <div class="left-col">
      <slot />
    </div>

    <aside class="sidebar">
      <PricingCard rows={p.pricing} note={p.pricingNote} footnote={p.pricingFootnote} />
      <IncludesCard included={p.included} notIncluded={p.notIncluded} />
      <BookingForm trek={p.bookingName ?? p.name} />
    </aside>
  </div>

  <RelatedTreks current={p.path.replace(/^\//, '')} related={p.related} />
</BaseLayout>
