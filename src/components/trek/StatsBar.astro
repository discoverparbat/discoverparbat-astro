---
// The row of quick facts under the hero (Duration, Difficulty, …)
interface Props { stats: { value: string; label: string }[] }
const { stats } = Astro.props;
---
<div class="stats-bar">
  {stats.map((s) => (
    <div class="stat-item">
      <div class="stat-value">{s.value}</div>
      <div class="stat-label">{s.label}</div>
    </div>
  ))}
</div>
