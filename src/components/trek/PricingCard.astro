---
// "Cost Details" table in the sidebar. rows: { group: "1 Person", price: "$410" }
export interface PriceRow { group: string; price: string }
interface Props { rows: PriceRow[]; title?: string; note?: string; footnote?: string }
const { rows, title = 'Cost Details', note = 'Per person · All inclusive', footnote } = Astro.props;
---
<div class="pricing-card">
  <div class="pricing-card-header">
    <h3>{title}</h3>
    <p>{note}</p>
  </div>
  <table class="pricing-table">
    <thead>
      <tr><th>Group Size</th><th>Per Person</th></tr>
    </thead>
    <tbody>
      {rows.map((r) => <tr><td>{r.group}</td><td>{r.price}</td></tr>)}
    </tbody>
  </table>
  {footnote && <p class="pricing-note" set:html={footnote} />}
</div>
