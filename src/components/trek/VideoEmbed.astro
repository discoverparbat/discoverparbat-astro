---
// YouTube video. Shows the video's thumbnail with a play button and only
// loads YouTube when the visitor clicks — keeps the page fast.
// Pass the YouTube video id (the part after "watch?v=").
interface Props {
  id: string;
  title: string;      // describes the video (for screen readers / YouTube)
  heading?: string;   // optional title above the video, e.g. "Watch the Mardi Himal Trek"
  caption?: string;   // optional line under the video
}
const { id, title, heading, caption } = Astro.props;
const boxId = `video-${id}`;
---
<div class="trek-video">
  {heading && <h3>✦ {heading}</h3>}
  <div class="video-frame" id={boxId}>
    <button type="button" class="video-poster" aria-label={`Play: ${title}`}
            data-video-id={id} data-video-title={title}>
      <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt={title} loading="lazy" width="480" height="360">
      <span class="video-play"><svg viewBox="0 0 24 24" aria-hidden="true"><polygon points="6 4 20 12 6 20"/></svg></span>
    </button>
  </div>
  {caption && <p class="video-caption">{caption}</p>}
  <noscript>
    <p><a href={`https://www.youtube.com/watch?v=${id}`} target="_blank" rel="noopener">Watch “{title}” on YouTube</a></p>
  </noscript>
</div>
