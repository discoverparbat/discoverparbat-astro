---
// URL: https://discoverparbat.com/treks
// This page keeps its own design: its styles are in the <style> block
// below and the page HTML follows. BaseLayout adds the head, header and footer.
import BaseLayout from '../layouts/BaseLayout.astro';
import { getListedTreks, DIFFICULTY_LABEL } from '../lib/treks';
// Trek cards, the comparison table and the count all come from the trek files
// (src/content/treks/*.json → "Listing" settings in the CMS).
const TREKS = await getListedTreks();
const byDays = [...TREKS].sort((a, b) => a.days - b.days);
const TREK_GROUPS = [
  { id: 'parbat', eyebrow: 'Our Own Routes', title: 'Parbat <span>Village Treks</span>', lead: 'Quiet trails we opened and guide ourselves, with homestays, local families and wide mountain views far from the busy routes.' },
  { id: 'classic', eyebrow: 'Classic Himalaya', title: 'Annapurna <span>&amp; Beyond</span>', lead: "Nepal's best-known routes, led by our own local guides, from short viewpoint treks to the full Annapurna Circuit." },
];

// Google schema (JSON-LD), kept from the old page
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Treks by Discover Parbat",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Kokhe Danda Trek",
        "url": "https://discoverparbat.com/kokhe-danda-trek"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Short Kokhe Danda Trek",
        "url": "https://discoverparbat.com/short-kokhe-danda-trek"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Muldai Viewpoint Poon Hill Trek",
        "url": "https://discoverparbat.com/muldai-viewpoint-trek"
      },
      {
        "@type": "ListItem",
        "position": 4,
        "name": "Multiple Viewpoints Trek",
        "url": "https://discoverparbat.com/multiple-viewpoints-trek"
      },
      {
        "@type": "ListItem",
        "position": 5,
        "name": "Poon Hill Trek",
        "url": "https://discoverparbat.com/poonhill-trek"
      },
      {
        "@type": "ListItem",
        "position": 6,
        "name": "Mardi Himal Trek",
        "url": "https://discoverparbat.com/mardi-himal-trek"
      },
      {
        "@type": "ListItem",
        "position": 7,
        "name": "Khopra Ridge Trek",
        "url": "https://discoverparbat.com/khopra-ridge-trek"
      },
      {
        "@type": "ListItem",
        "position": 8,
        "name": "Annapurna Base Camp Trek",
        "url": "https://discoverparbat.com/annapurna-base-camp-trek"
      },
      {
        "@type": "ListItem",
        "position": 9,
        "name": "Mardi Himal and Poon Hill Trek",
        "url": "https://discoverparbat.com/mardi-himal-and-poonhill-trek"
      },
      {
        "@type": "ListItem",
        "position": 10,
        "name": "Annapurna Circuit Trek",
        "url": "https://discoverparbat.com/annapurna-circuit-trek"
      },
      {
        "@type": "ListItem",
        "position": 11,
        "name": "Pikey Peak Trek",
        "url": "https://discoverparbat.com/pikey-peak-trek"
      }
    ]
  }
];
---
<BaseLayout
  title="Treks | Discover Parbat"
  description="Browse all Discover Parbat treks — from 4-day Kokhe Danda to the 14-day Multiple Viewpoints route. Offbeat Annapurna region trails, locally guided, small groups only."
  path="/treks"
  keywords="Parbat trekking, Nepal trek, Kokhe Danda trek, Mardi Himal, Khopra Ridge, Annapurna trek, Himalayan trekking, local guides Nepal"
  image="/kokhe.jpg"
  imageAlt="Himalayan Treks in Nepal | Discover Parbat"
  ogTitle="Himalayan Treks in Nepal | Discover Parbat"
  nav="/treks"
  schema={schema}
>

<style is:global>
/* ─── HERO SMALL ───────────────────────────────────── */
.hero-small {
  position: relative;
  height: 44vh;
  min-height: 320px;
  overflow: hidden;
  margin-top: 72px;
}
.hero-small img {
  width: 100%; height: 100%;
  object-fit: cover;
  object-position: center 60%;
}
.hero-small::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(10,30,20,0.3) 0%, rgba(10,30,20,0.65) 100%);
}
.hero-small-content {
  position: absolute;
  z-index: 2;
  bottom: 14%;
  left: 7%;
  animation: fadeUp 0.9s ease both;
}
@keyframes fadeUp {
  from { opacity:0; transform: translateY(20px); }
  to   { opacity:1; transform: translateY(0); }
}
.hero-eyebrow {
  display: inline-block;
  background: rgba(82,183,136,0.25);
  border: 1px solid rgba(82,183,136,0.5);
  color: #a8e6c5;
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  padding: 5px 14px;
  border-radius: 100px;
  margin-bottom: 14px;
}
.hero-small h1 {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(2.4rem, 5vw, 4rem);
  font-weight: 700;
  color: var(--white);
  line-height: 1.1;
  text-shadow: 0 2px 20px rgba(0,0,0,0.3);
}
.hero-small-sub {
  margin-top: 10px;
  font-size: 1.02rem;
  font-weight: 300;
  color: rgba(255,255,255,0.85);
}

/* ─── INTRO STRIP ──────────────────────────────────── */
.intro-strip {
  background: var(--white);
  border-bottom: 1px solid rgba(0,0,0,0.06);
  padding: 34px 7%;
  display: flex;
  align-items: center;
  gap: 20px;
}
.intro-line {
  width: 4px;
  height: 52px;
  background: linear-gradient(to bottom, var(--green-mid), var(--blue-mid));
  border-radius: 4px;
  flex-shrink: 0;
}
.intro-strip p {
  font-size: 1.05rem;
  line-height: 1.75;
  color: var(--text-mid);
  max-width: 780px;
}

/* ─── FILTER BAR ───────────────────────────────────── */
.tk-filter {
  position: sticky;
  top: 72px;
  z-index: 20;
  background: rgba(255,255,255,0.94);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border-bottom: 1px solid rgba(0,0,0,0.06);
  padding: 14px 7%;
  display: flex;
  align-items: center;
  gap: 18px;
  flex-wrap: wrap;
}
.tk-filter-group {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}
.tk-filter-label {
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--green-mid);
  margin-right: 2px;
}
.tk-chip {
  border: 1px solid rgba(0,0,0,0.12);
  background: var(--white);
  color: var(--text-dark);
  font-family: 'DM Sans', sans-serif;
  font-size: 0.82rem;
  font-weight: 500;
  padding: 7px 15px;
  border-radius: 100px;
  cursor: pointer;
  transition: background var(--transition), color var(--transition), border-color var(--transition);
}
.tk-chip:hover { border-color: var(--green-mid); }
.tk-chip.is-active {
  background: var(--green-mid);
  border-color: var(--green-mid);
  color: var(--white);
}
.tk-count {
  margin-left: auto;
  font-size: 0.82rem;
  color: #6b7280;
}

/* ─── SECTION HEADER ───────────────────────────────── */
.section-header { padding: 56px 7% 30px; }
.section-eyebrow {
  display: inline-block;
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--green-mid);
  margin-bottom: 12px;
}
.section-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(2rem, 3.5vw, 2.8rem);
  font-weight: 700;
  color: var(--text-dark);
  line-height: 1.15;
}
.section-title span {
  background: linear-gradient(135deg, var(--green-mid), var(--blue-mid));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.section-lead {
  margin-top: 12px;
  font-size: 0.97rem;
  line-height: 1.7;
  color: var(--text-mid);
  max-width: 640px;
}
.title-divider {
  width: 48px;
  height: 3px;
  background: linear-gradient(90deg, var(--green-light), var(--blue-light));
  border-radius: 3px;
  margin-top: 16px;
}

/* ─── FEATURED TREK ────────────────────────────────── */
.tk-featured-wrap { padding: 48px 7% 0; }
.tk-featured {
  display: grid;
  grid-template-columns: 1.25fr 1fr;
  background: var(--white);
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: var(--shadow-md);
  border: 1px solid rgba(0,0,0,0.05);
  text-decoration: none;
  color: inherit;
  transition: transform var(--transition), box-shadow var(--transition);
}
.tk-featured:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
.tk-featured-img { position: relative; min-height: 380px; overflow: hidden; }
.tk-featured-img img {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  object-fit: cover;
  transition: transform 0.6s cubic-bezier(0.4,0,0.2,1);
}
.tk-featured:hover .tk-featured-img img { transform: scale(1.05); }
.tk-ribbon {
  position: absolute;
  top: 18px; left: 18px;
  z-index: 2;
  background: linear-gradient(135deg, var(--green-dark), var(--blue-deep));
  color: var(--white);
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  padding: 7px 14px;
  border-radius: 100px;
}
.tk-featured-body {
  padding: 40px 42px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 14px;
}
.tk-featured-body h2 {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(2rem, 3vw, 2.6rem);
  font-weight: 700;
  color: var(--text-dark);
  line-height: 1.1;
}
.tk-featured-body > p {
  font-size: 0.97rem;
  color: var(--text-mid);
  line-height: 1.75;
}
.tk-facts {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border-top: 1px solid rgba(0,0,0,0.07);
  border-bottom: 1px solid rgba(0,0,0,0.07);
  margin: 6px 0;
}
.tk-fact { padding: 14px 0; text-align: center; }
.tk-fact + .tk-fact { border-left: 1px solid rgba(0,0,0,0.07); }
.tk-fact strong { display: block; font-size: 1.12rem; font-weight: 600; color: var(--text-dark); }
.tk-fact span {
  font-size: 0.66rem;
  font-weight: 600;
  letter-spacing: 1.4px;
  text-transform: uppercase;
  color: var(--green-mid);
}
.tk-btn {
  align-self: flex-start;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: linear-gradient(135deg, var(--green-mid), var(--blue-mid));
  color: var(--white);
  font-size: 0.9rem;
  font-weight: 700;
  padding: 12px 22px;
  border-radius: 10px;
  box-shadow: 0 8px 22px rgba(45,106,79,0.25);
  transition: gap var(--transition);
}
.tk-featured:hover .tk-btn { gap: 12px; }

/* ─── TREK GRID ────────────────────────────────────── */
.tk-group[hidden] { display: none; }
.tk-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
  gap: 26px;
  padding: 0 7% 20px;
}
.tk-card {
  display: flex;
  flex-direction: column;
  background: var(--white);
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  border: 1px solid rgba(0,0,0,0.05);
  text-decoration: none;
  color: inherit;
  transition: transform var(--transition), box-shadow var(--transition);
}
.tk-card[hidden] { display: none; }
.tk-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-lg); }
.tk-card-img { position: relative; aspect-ratio: 4 / 3; overflow: hidden; }
.tk-card-img img {
  width: 100%; height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.6s cubic-bezier(0.4,0,0.2,1);
}
.tk-card:hover .tk-card-img img { transform: scale(1.07); }
.tk-card-img::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(10,30,20,0) 55%, rgba(10,30,20,0.45) 100%);
  pointer-events: none;
}
.tk-days {
  position: absolute;
  z-index: 2;
  left: 14px; bottom: 14px;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: rgba(255,255,255,0.95);
  color: var(--text-dark);
  font-size: 0.8rem;
  font-weight: 700;
  padding: 6px 13px;
  border-radius: 100px;
  box-shadow: 0 4px 14px rgba(0,0,0,0.15);
}
.tk-days svg { width: 13px; height: 13px; stroke: var(--green-mid); fill: none; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
.tk-card-body {
  padding: 22px 24px 24px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  flex: 1;
}
.tk-region {
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 1.8px;
  text-transform: uppercase;
  color: #8a949c;
}
.tk-card-body h3 {
  font-family: 'Playfair Display', serif;
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--text-dark);
  line-height: 1.25;
}

/* Difficulty + max altitude, read together under the trek name */
.tk-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  margin: 2px 0 4px;
}
.tk-alt {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 12px;
  border-radius: 100px;
  background: #f3f4f2;
  border: 1px solid rgba(0,0,0,0.08);
  color: var(--text-dark);
  font-size: 0.74rem;
  font-weight: 600;
  white-space: nowrap;
}
.tk-alt svg { width: 13px; height: 13px; fill: #6b7a72; flex-shrink: 0; }
.tk-alt small { font-size: 0.7rem; font-weight: 500; color: #6b7a72; }

.tk-card-body p {
  font-size: 0.9rem;
  color: #666;
  line-height: 1.6;
  flex: 1;
}
.tk-card-foot {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 8px;
  padding-top: 14px;
  border-top: 1px solid rgba(0,0,0,0.06);
}
.tk-arrow {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--green-mid);
  transition: gap var(--transition);
}
.tk-card:hover .tk-arrow { gap: 10px; }

/* Difficulty badges */
.badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 12px;
  border-radius: 100px;
  font-size: 0.74rem;
  font-weight: 600;
  letter-spacing: 0.3px;
  white-space: nowrap;
}
.badge-dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
.badge-easy     { background: rgba(45,106,79,0.1);  color: var(--green-mid); border: 1px solid rgba(45,106,79,0.2); }
.badge-moderate { background: rgba(26,111,168,0.1); color: var(--blue-mid);  border: 1px solid rgba(26,111,168,0.2); }
.badge-hard     { background: rgba(176,96,40,0.1);  color: #a0561f;          border: 1px solid rgba(176,96,40,0.25); }
.badge-easy .badge-dot     { background: var(--green-mid); }
.badge-moderate .badge-dot { background: var(--blue-mid); }
.badge-hard .badge-dot     { background: #a0561f; }

.tk-empty {
  display: none;
  margin: 10px 7% 40px;
  padding: 28px;
  text-align: center;
  background: var(--white);
  border-radius: var(--radius);
  border: 1px dashed rgba(0,0,0,0.15);
  color: var(--text-mid);
}
.tk-empty.is-visible { display: block; }
.tk-empty a { color: var(--green-mid); font-weight: 600; }

/* ─── COMPARE TABLE ────────────────────────────────── */
.tk-compare-wrap { padding: 0 7% 64px; }
.tk-compare-scroll {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  background: var(--white);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
  border: 1px solid rgba(0,0,0,0.05);
}
.tk-compare { width: 100%; min-width: 640px; border-collapse: collapse; }
.tk-compare thead tr { background: rgba(45,106,79,0.06); }
.tk-compare th {
  padding: 14px 20px;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--green-mid);
  text-align: left;
  border-bottom: 1px solid rgba(0,0,0,0.07);
}
.tk-compare td {
  padding: 14px 20px;
  font-size: 0.92rem;
  color: var(--text-dark);
  border-bottom: 1px solid rgba(0,0,0,0.05);
}
.tk-compare tr:last-child td { border-bottom: none; }
.tk-compare tbody tr:hover td { background: rgba(45,106,79,0.03); }
.tk-compare a { color: var(--text-dark); font-weight: 600; text-decoration: none; }
.tk-compare a:hover { color: var(--green-mid); text-decoration: underline; }

/* ─── HELP BAND ────────────────────────────────────── */
.tk-help {
  margin: 0 7% 72px;
  padding: 34px 38px;
  border-radius: var(--radius);
  background: var(--white);
  border: 1px solid rgba(45,106,79,0.15);
  box-shadow: var(--shadow-sm);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  flex-wrap: wrap;
}
.tk-help h3 {
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.7rem;
  font-weight: 700;
  color: var(--text-dark);
  line-height: 1.15;
  margin-bottom: 6px;
}
.tk-help p { font-size: 0.95rem; color: var(--text-mid); line-height: 1.6; max-width: 560px; }
.tk-help-actions { display: flex; gap: 12px; flex-wrap: wrap; }
.tk-help .tk-btn { text-decoration: none; }
.tk-btn-ghost {
  display: inline-flex;
  align-items: center;
  padding: 12px 22px;
  border-radius: 10px;
  border: 1.5px solid var(--green-mid);
  color: var(--green-mid);
  font-size: 0.9rem;
  font-weight: 700;
  text-decoration: none;
  transition: background var(--transition), color var(--transition);
}
.tk-btn-ghost:hover { background: var(--green-mid); color: var(--white); }

/* ─── WHY SECTION ──────────────────────────────────── */
.why-section {
  background: linear-gradient(160deg, var(--green-dark) 0%, var(--blue-deep) 100%);
  padding: 72px 7%;
  position: relative;
  overflow: hidden;
}
.why-section::before {
  content: '';
  position: absolute;
  top: -100px; right: -100px;
  width: 500px; height: 500px;
  border-radius: 50%;
  background: rgba(82,183,136,0.06);
  pointer-events: none;
}
.why-inner { max-width: 720px; }
.why-section .section-eyebrow { color: var(--green-light); }
.why-section h2 {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(2rem, 3.5vw, 2.8rem);
  font-weight: 700;
  color: var(--white);
  line-height: 1.18;
  margin: 14px 0 20px;
}
.why-section p {
  font-size: 1rem;
  line-height: 1.8;
  color: rgba(255,255,255,0.72);
  max-width: 640px;
}
.why-divider {
  width: 48px;
  height: 3px;
  background: linear-gradient(90deg, var(--green-light), var(--blue-light));
  border-radius: 3px;
  margin: 20px 0 0;
}

/* ─── RESPONSIVE ───────────────────────────────────── */
@media (max-width: 960px) {
  .tk-featured { grid-template-columns: 1fr; }
  .tk-featured-img { min-height: 280px; }
  .tk-featured-body { padding: 30px 28px; }
}
@media (max-width: 640px) {
  .intro-strip { padding: 26px 5%; }
  .tk-filter { padding: 12px 5%; gap: 10px; top: 64px; }
  .tk-filter-group { flex-wrap: nowrap; overflow-x: auto; width: 100%; padding-bottom: 2px; scrollbar-width: none; }
  .tk-filter-group::-webkit-scrollbar { display: none; }
  .tk-chip { flex-shrink: 0; }
  .tk-count { margin-left: 0; }
  .tk-featured-wrap { padding: 32px 5% 0; }
  .tk-featured-body { padding: 24px 20px; }
  .section-header { padding: 42px 5% 24px; }
  .tk-grid { padding: 0 5% 16px; gap: 20px; }
  .tk-compare-wrap { padding: 0 5% 48px; }
  .tk-help { margin: 0 5% 52px; padding: 26px 22px; }
  .tk-empty { margin: 10px 5% 32px; }
  .why-section { padding: 50px 5%; }
}
@media (max-width: 480px) {
  .tk-facts { grid-template-columns: repeat(2, 1fr); }
  .tk-fact:nth-child(3) { border-left: none; }
  .tk-fact:nth-child(n+3) { border-top: 1px solid rgba(0,0,0,0.07); }
}
</style>

<!-- Reusable icons (referenced with <use>) -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="i-cal" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></symbol>
  <symbol id="i-peak" viewBox="0 0 24 24"><path d="M2 20 9.5 7l3.6 6.2L15.5 10 22 20z"/></symbol>
</svg>

<!-- ─── HERO ───────────────────────────────────────── -->
<section class="hero-small">
  <img src="/kokhe.jpg" alt="Himalayan panorama from Kokhe Danda in Parbat, Nepal" fetchpriority="high">
  <div class="hero-small-content">
    <div class="hero-eyebrow">Parbat, Nepal · {TREKS.length} Treks</div>
    <h1>Our Treks</h1>
