<!-- ─── FOOTER ─────────────────────────────────────── -->

<script is:inline>
  // Trek filter: difficulty or duration (one chip at a time)
  (function () {
    const chips    = document.querySelectorAll('.tk-chip');
    const cards    = document.querySelectorAll('.tk-card');
    const groups   = document.querySelectorAll('[data-group]');
    const featured = document.getElementById('tk-featured-wrap');
    const count    = document.getElementById('tk-count');
    const empty    = document.getElementById('tk-empty');

    // Featured Kokhe Danda trek: Easy, 5 days
    const featuredData = { diff: 'easy', days: 5 };

    function matches(diff, days, f) {
      if (f === 'all')   return true;
      if (f === 'short') return days <= 5;
      if (f === 'mid')   return days >= 6 && days <= 10;
      if (f === 'long')  return days >= 11;
      return diff === f;
    }

    function apply(f) {
      let shown = 0;
      cards.forEach((c) => {
        const ok = matches(c.dataset.diff, Number(c.dataset.days), f);
        c.hidden = !ok;
        if (ok) shown++;
      });
      groups.forEach((g) => {
        g.hidden = !g.querySelector('.tk-card:not([hidden])');
      });
      const featOk = matches(featuredData.diff, featuredData.days, f);
      featured.hidden = !featOk;
      if (featOk) shown++;

      count.textContent = 'Showing ' + shown + (shown === 1 ? ' trek' : ' treks');
      empty.classList.toggle('is-visible', shown === 0);
    }

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        chips.forEach((c) => c.classList.remove('is-active'));
        chip.classList.add('is-active');
        apply(chip.dataset.filter);
      });
    });
  })();
</script>

