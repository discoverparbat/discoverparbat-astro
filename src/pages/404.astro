---
// Shown for any URL that doesn't exist (set in public/.htaccess: ErrorDocument 404).
// noindex so Google never lists it.
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTrekCards } from '../lib/treks';
const TREKS = await getTrekCards();
const popular = TREKS.filter((t) => ['/kokhe-danda-trek', '/khopra-ridge-trek', '/api-himal-base-camp-trek', '/mardi-himal-trek'].includes(t.url));
---
<BaseLayout
  title="Page not found | Discover Parbat"
  description="The page you are looking for does not exist."
  path="/404"
  noindex
>
  <main class="nf">
    <p class="nf-code">404</p>
    <h1>This trail doesn't go anywhere</h1>
    <p>The page you are looking for does not exist or has moved.</p>
    <p class="nf-links"><a class="nf-btn" href="/">Back to home</a> <a class="nf-btn nf-ghost" href="/treks">View all treks</a></p>
    <ul class="nf-popular">
      {popular.map((t) => <li><a href={t.url}>{t.name}</a></li>)}
      <li><a href="/articles">Articles &amp; stories</a></li>
    </ul>
  </main>
</BaseLayout>

<style>
  .nf { max-width: 620px; margin: 0 auto; padding: 150px 24px 90px; text-align: center; }
  .nf-code { font-family: 'Cormorant Garamond', serif; font-size: 5rem; font-weight: 700; color: var(--green-mid); line-height: 1; margin-bottom: 8px; }
  .nf h1 { font-family: 'Playfair Display', serif; font-size: clamp(1.6rem, 4vw, 2.2rem); color: var(--text-dark); margin-bottom: 12px; }
  .nf p { color: var(--text-mid); line-height: 1.7; }
  .nf-links { margin: 26px 0 30px; display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .nf-btn { display: inline-block; padding: 12px 24px; border-radius: 999px; background: var(--green-dark); color: #fff; text-decoration: none; font-weight: 600; }
  .nf-ghost { background: transparent; color: var(--green-dark); border: 1.5px solid var(--green-dark); }
  .nf-popular { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 18px; justify-content: center; }
  .nf-popular a { color: var(--green-mid); font-weight: 600; text-decoration: none; }
  .nf-popular a:hover { text-decoration: underline; }
</style>
