# ─────────────────────────────────────────────────────────────
# Discover Parbat — Apache rules (Hostinger)
# Sections 1–4 are copied unchanged from the old site so every old
# URL keeps redirecting exactly as before. Section 5 is new: it serves
# the static pages Astro builds (kokhe-danda-trek.html) at clean URLs.
# To add a redirect for a renamed page, copy a line in section 3.
# ─────────────────────────────────────────────────────────────

RewriteEngine On
RewriteBase /

# ── 1. One domain: https://discoverparbat.com (no www, no http) ──
RewriteCond %{HTTP_HOST} ^www\.discoverparbat\.com$ [NC]
RewriteRule ^(.*)$ https://discoverparbat.com/$1 [R=301,L,NE]

# Any other host name that reaches this site (e.g. the automatic Hostinger
# alias discoverparbat.com.grnca.org, which Google had indexed) → the real domain.
RewriteCond %{HTTP_HOST} !^discoverparbat\.com$ [NC]
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
RewriteRule ^(.*)$ https://discoverparbat.com/$1 [R=301,L,NE]

RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^(.*)$ https://discoverparbat.com/$1 [R=301,L,NE]

# ── 2. Old spam pages → 410 Gone ──
RewriteRule ^items/ - [G,L]

# ── 3. Old / renamed URLs → current pages (keeps their Google ranking) ──
RewriteRule ^khopra-danda-trek/?$ https://discoverparbat.com/khopra-ridge-trek [R=301,L,NC]
RewriteRule ^haljure/?$ https://discoverparbat.com/parbat-dashain-travel-destinations [R=301,L,NC]
RewriteRule ^best-time-to-trek-kokhe-danda/?$ https://discoverparbat.com/best-season-for-kokhe-danda-trek [R=301,L,NC]
RewriteRule ^best-season-for-khopra-ridge-trek/?$ https://discoverparbat.com/khopra-ridge-trek [R=301,L,NC]
RewriteRule ^4-days-poon-hill-trek/?$ https://discoverparbat.com/poonhill-trek [R=301,L,NC]
RewriteRule ^mardi-himal-poonhill-trek/?$ https://discoverparbat.com/mardi-himal-and-poonhill-trek [R=301,L,NC]
RewriteRule ^why-kokhe-danda-trek/?$ https://discoverparbat.com/article/why-kokhe-danda-trek [R=301,L,NC]
# Oct 2026: Short Multiple Viewpoints Trek renamed to Muldai Viewpoint Trek
RewriteRule ^short-multiple-viewpoints-trek(\.html)?/?$ https://discoverparbat.com/muldai-viewpoint-trek [R=301,L,NC]

RewriteRule ^article/multiple-viewpoints-trek-alternative-to-annapurna-circuit/?$ https://discoverparbat.com/multiple-viewpoints-trek-alternative-to-annapurna-circuit [R=301,L,NC]
RewriteRule ^article/best-season-kokhe-danda-trek/?$ https://discoverparbat.com/best-season-for-kokhe-danda-trek [R=301,L,NC]
RewriteRule ^article/article-kokhe-danda-trek-best-alternative-to-poon-hill/?$ https://discoverparbat.com/kokhe-danda-trek-alternative-to-poon-hill [R=301,L,NC]
RewriteRule ^article/article-why-kokhe-danda-trek-is-best-short-trek-in-nepal/?$ https://discoverparbat.com/article/why-kokhe-danda-trek [R=301,L,NC]
RewriteRule ^article/why-choose-discover-parbat-for-kokhe-danda-trek/?$ https://discoverparbat.com/article/why-kokhe-danda-trek [R=301,L,NC]
RewriteRule ^article/annapurna-circuit-trek-conditions-after-recent-weather/?$ https://discoverparbat.com/annapurna-circuit-trail-condition-update [R=301,L,NC]
RewriteRule ^article/annapurna-circuit-trail-condition-update/?$ https://discoverparbat.com/annapurna-circuit-trail-condition-update [R=301,L,NC]
RewriteRule ^article/annapurna-circuit-trek-update/?$ https://discoverparbat.com/annapurna-circuit-trail-condition-update [R=301,L,NC]
RewriteRule ^article/what-to-pack-for-khopra-ridge-trek/?$ https://discoverparbat.com/what-to-pack-for-khopra-ridge-trek [R=301,L,NC]
RewriteRule ^article/best-time-to-do-khopra-ridge-trek/?$ https://discoverparbat.com/khopra-ridge-trek [R=301,L,NC]
RewriteRule ^article/kimrong-khola-bridge-swept-away-abc-trail-update/?$ https://discoverparbat.com/annapurna-base-camp-trek [R=301,L,NC]
RewriteRule ^article/article-is-monsoon-really-a-bad-time-to-trek-in-nepal/?$ https://discoverparbat.com/article/nepal-monsoon-officially-exits-2026 [R=301,L,NC]
RewriteRule ^article/article-best-season-to-trek-in-nepal/?$ https://discoverparbat.com/article/nepal-monsoon-officially-exits-2026 [R=301,L,NC]

# ── Admin shortcut: /admin → the Pages CMS editor for this site (temporary redirect, not indexed)
RewriteRule ^admin/?$ https://app.pagescms.org/discoverparbat/discoverparbat-astro/main [R=302,L,NC]

# ── 4. Legacy mixed-case .html URLs → lowercase clean URLs ──
# Case-sensitive on purpose (no NC): section 5 turns /shop into shop.html
# internally, and an NC rule would match that and redirect in a loop.
# Lowercase .html URLs are handled by the general .html rule below.
RewriteRule ^Shop\.html$ https://discoverparbat.com/shop [R=301,L]
RewriteRule ^Kokhe-Danda-Trek\.html$ https://discoverparbat.com/kokhe-danda-trek [R=301,L]
RewriteRule ^Short-Kokhe-Danda-Trek\.html$ https://discoverparbat.com/short-kokhe-danda-trek [R=301,L]
RewriteRule ^Mardi-Himal-Trek\.html$ https://discoverparbat.com/mardi-himal-trek [R=301,L]
RewriteRule ^Khopra-Danda-Trek\.html$ https://discoverparbat.com/khopra-ridge-trek [R=301,L]
RewriteRule ^Annapurna-Base-Camp-Trek\.html$ https://discoverparbat.com/annapurna-base-camp-trek [R=301,L]
RewriteRule ^Multiple-Viewpoints-Trek\.html$ https://discoverparbat.com/multiple-viewpoints-trek [R=301,L]
RewriteRule ^Short-Multiple-Viewpoints-Trek\.html$ https://discoverparbat.com/muldai-viewpoint-trek [R=301,L]
RewriteRule ^Why-Discover-Parbat-For-Kokhe-Danda-Trek\.html$ https://discoverparbat.com/article/why-kokhe-danda-trek [R=301,L]
RewriteRule ^why-kokhe-danda-trek\.html$ https://discoverparbat.com/article/why-kokhe-danda-trek [R=301,L]

# index.html → homepage (must come before the general .html rule)
RewriteCond %{THE_REQUEST} \s/+index\.(html|php)[\s?] [NC]
RewriteRule ^ https://discoverparbat.com/ [R=301,L]

# Any other .html URL → extensionless (301), except the Google verification file
RewriteCond %{REQUEST_URI} !^/google[0-9a-f]+\.html$ [NC]
RewriteCond %{THE_REQUEST} \s/+([^?\s]*?)\.html[\s?] [NC]
RewriteRule ^ https://discoverparbat.com/%1 [R=301,L,NE]

# ── 5. Static site routing (no redirects) ──
DirectoryIndex index.html
# Don't let Apache add a slash to folder names (/about → /about/) before
# these rules run; pages are files, and real folders hold only assets.
DirectorySlash Off

# A leftover folder on the server with the same name as a page (e.g. an old
# about/ folder, Nov 2026) must never block that page, so these rules check
# for the page's .html file instead of skipping every folder.

# Trailing slash on a page URL → no slash (one URL per page)
RewriteCond %{REQUEST_FILENAME} !-d [OR]
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)/$ https://discoverparbat.com/$1 [R=301,L]

# Clean URL → the built .html file: /kokhe-danda-trek → kokhe-danda-trek.html,
# /article/khayer-lake-guide → article/khayer-lake-guide.html
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# ── 6. Errors & security ──
ErrorDocument 404 /404.html

# Never serve config or hidden files
<FilesMatch "^(smtp-config|cms-config).*\.php$|^\.">
  Require all denied
</FilesMatch>
